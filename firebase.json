{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/v1/ingestions/**",
        "function": {
          "functionId": "clinicalApi",
          "region": "asia-northeast3"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": {
    "source": "functions",
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run lint"
    ],
    "runtime": "nodejs22"
  },
  "emulators": {
    "firestore": {
      "host": "127.0.0.1",
      "port": 18080
    },
    "storage": {
      "host": "127.0.0.1",
      "port": 19199
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "dfetmanage",
          "appId": "1:1011088994661:android:7b256f3f8c19223d5df18c",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "dfetmanage",
          "appId": "1:1011088994661:ios:58e7f0262c084e555df18c",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "dfetmanage",
          "configurations": {
            "android": "1:1011088994661:android:7b256f3f8c19223d5df18c",
            "ios": "1:1011088994661:ios:58e7f0262c084e555df18c",
            "web": "1:1011088994661:web:b53b172998bea9c85df18c"
          }
        }
      }
    }
  }
}
