rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin (checks 'admins' collection)
    function isAdmin() {
      return request.auth != null && 
        (
          ('admin' in request.auth.token && request.auth.token.admin == true) ||
          ('super_admin' in request.auth.token && request.auth.token.super_admin == true) ||
          // Check 'admins' collection
          (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['admin', 'super_admin'] &&
           get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.approvalStatus == 'approved')
          ||
          // Fallback: Check 'users' collection (for backward compatibility if needed)
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isApproved == true)
        );
    }

    // Helper function to check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Helper function to check if user is owner
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Helper function to check if user is a trainer (Custom Claim)
    function isTrainer() {
      return request.auth != null &&
        'trainer' in request.auth.token && request.auth.token.trainer == true;
    }

    function isLabOperator() {
      return request.auth != null && (
        ('lab_operator' in request.auth.token && request.auth.token.lab_operator == true) ||
        ('role' in request.auth.token && request.auth.token.role == 'lab_operator')
      );
    }

    // Helper to check if caller is the assigned trainer for a given member
    // 'trainers/{uid}.memberIds[]'에 memberId가 포함되어 있어야 함
    function isAssignedTrainer(memberId) {
      return isTrainer() &&
        exists(/databases/$(database)/documents/trainers/$(request.auth.uid)) &&
        memberId in get(/databases/$(database)/documents/trainers/$(request.auth.uid)).data.memberIds;
    }

    // --- Admins Collection (New) ---
    match /admins/{userId} {
      // 본인은 승인 대기 요청만 생성할 수 있다. 승인은 서버/기존 관리자만 수행한다.
      allow create: if isOwner(userId) &&
        request.resource.data.approvalStatus == 'pending' &&
        request.resource.data.role == 'admin' &&
        request.resource.data.keys().hasOnly([
          'email', 'displayName', 'createdAt', 'approvalStatus', 'role', 'lastLoginAt'
        ]);
      // Allow reading your own profile
      allow read: if isOwner(userId) || isAdmin();
      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'lastLoginAt'
        ])
      );
      allow delete: if isAdmin();
    }

    // --- Users Collection ---
    match /users/{userId} {
      // 본인 / 관리자 / 담당 트레이너만 읽기 가능
      allow read: if isOwner(userId) || isAdmin() || isAssignedTrainer(userId);
      // 역할·승인·구독 필드는 클라이언트가 스스로 승격할 수 없도록 고정한다.
      allow create: if isOwner(userId) &&
        request.resource.data.role in ['user', 'member'] &&
        request.resource.data.isAdmin != true &&
        request.resource.data.isTrainer != true &&
        request.resource.data.isApproved != true &&
        request.resource.data.isPremium != true;
      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'email', 'displayName', 'photoURL', 'provider', 'lastLoginAt',
          'gender', 'age', 'height', 'weight', 'activityLevel', 'goal',
          'careType', 'careTypeVersion', 'careTypeConfirmedAt',
          'isOnboardingComplete'
        ])
      );
      allow delete: if isAdmin();

      // Subcollections (meals, workouts)
      // 본인은 read/write, 담당 트레이너는 read만, 관리자는 모두
      match /{collection}/{document=**} {
        allow read: if isOwner(userId) || isAdmin() || isAssignedTrainer(userId);
        allow write: if isOwner(userId) || isAdmin();
      }
    }

    // --- Trainers Collection ---
    // setTrainerClaim Function이 문서를 생성/수정. 클라이언트 쓰기는 허용하지 않음.
    match /trainers/{trainerId} {
      // 본인 트레이너 또는 관리자만 read
      allow read: if isOwner(trainerId) || isAdmin();
      // 클라이언트 쓰기 금지 (Cloud Function에서만 admin SDK로 수정)
      allow write: if false;
    }

    // --- SOAP Notes Collection ---
    // 트레이너가 작성. 회원은 자신에게 공유된 것만 읽기 가능.
    match /soap_notes/{noteId} {
      allow read: if isAuth() && (
        resource.data.trainerId == request.auth.uid ||
        (resource.data.memberId == request.auth.uid &&
         resource.data.isSharedWithMember == true) ||
        isAdmin()
      );
      // 생성: 호출자가 트레이너이고, 작성자(trainerId)가 본인이며, 담당 회원이어야 함
      allow create: if isTrainer() &&
        request.resource.data.trainerId == request.auth.uid &&
        isAssignedTrainer(request.resource.data.memberId);
      // 수정: 본인 트레이너 또는 관리자. 단 trainerId는 변경 불가
      allow update: if isAdmin() || (
        isTrainer() &&
        resource.data.trainerId == request.auth.uid &&
        request.resource.data.trainerId == resource.data.trainerId
      );
      // 삭제: 본인 트레이너 또는 관리자
      allow delete: if isAdmin() || (
        isTrainer() && resource.data.trainerId == request.auth.uid
      );
    }

    // --- Community (Posts) ---
    match /posts/{postId} {
      // Anyone authenticated can read posts
      allow read: if isAuth();
      // Authenticated users can create posts
      allow create: if isAuth() && request.resource.data.authorId == request.auth.uid;
      // Only author or admin can update/delete
      allow update, delete: if isAuth() && (resource.data.authorId == request.auth.uid || isAdmin());
      
      // Likes subcollection
      match /likes/{userId} {
        allow read: if isAuth();
        allow write: if isOwner(userId);
      }
      
      // Comments subcollection
      match /comments/{commentId} {
        allow read: if isAuth();
        allow create: if isAuth() && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if isAuth() && (resource.data.authorId == request.auth.uid || isAdmin());
      }
    }

    // --- Content Management (Workouts/Foods) ---
    match /content_workouts/{document=**} {
      allow read: if isAuth(); // All users can view workouts
      allow write: if isAdmin(); // Only admin can manage
    }

    match /content_foods/{document=**} {
      allow read: if isAuth(); // All users can view foods
      allow write: if isAdmin(); // Only admin can manage
    }

    // --- Requests ---
    match /requests/{requestId} {
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow read: if isOwner(resource.data.userId) ||
        isAssignedTrainer(resource.data.userId) || isAdmin();
      allow update: if isAssignedTrainer(resource.data.userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // --- Clinical consumer projections ---
    // All writes are performed with the Admin SDK after ingestion validation.
    match /gutReports/{reportId} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        isAssignedTrainer(resource.data.userId) ||
        isAdmin()
      );
      allow write: if false;
    }

    match /bloodReports/{reportId} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        isAssignedTrainer(resource.data.userId) ||
        isAdmin()
      );
      allow write: if false;
    }

    match /healthSnapshots/{snapshotId} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        isAssignedTrainer(resource.data.userId) ||
        isAdmin()
      );
      allow write: if false;
    }

    // --- Clinical expert projections ---
    // Members cannot read these documents, even when the report is theirs.
    match /gutReportExperts/{reportId} {
      allow read: if isAuth() && (
        isAssignedTrainer(resource.data.userId) || isAdmin()
      );
      allow write: if false;
    }

    match /bloodReportExperts/{reportId} {
      allow read: if isAuth() && (
        isAssignedTrainer(resource.data.userId) || isAdmin()
      );
      allow write: if false;
    }

    // Operational collections are accessed by the Next.js server after role
    // verification. Direct client writes are intentionally disabled.
    match /ingestionJobs/{jobId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /referenceRangeVersions/{versionId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /insightPolicyVersions/{versionId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /memberAliases/{aliasId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /clinicalReportKeys/{reportKeyId} {
      allow read, write: if false;
    }

    match /auditLogs/{auditId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /appConfig/{configId} {
      allow read: if isAuth();
      allow write: if false;
    }
  }
}
