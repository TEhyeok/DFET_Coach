{
  "name": "functions",
  "version": "1.0.0",
  "description": "Firebase Functions for D-FET Admin Dashboard",
  "main": "index.js",
  "scripts": {
    "lint": "node --check index.js && find src -name '*.js' -print0 | xargs -0 -n1 node --check",
    "test": "node --test test/clinical.test.js \"test/unit/**/*.test.js\"",
    "test:rules": "node --test test/firestore-rules.test.js",
    "test:e2e": "node --test test/clinical-emulator-e2e.js",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "firebase": "^12.17.0"
  },
  "dependencies": {
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.3.2"
  },
  "private": true
}
