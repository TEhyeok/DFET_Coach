  "causalPatterns": [
    {
      "id": "C2-01",
      "prdRow": "A 때문에 B / A로 인해 B",
      "regex": "(때문에|(으)?로\\s*인해|덕분에)",
      "severity": "warn",
      "allowedExample": "같은 기간에 ~와 ~ 변화가 함께 관찰됐어요"
    },
    {
      "id": "C2-02",
      "prdRow": "A하면 B가 좋아진다",
      "regex": "하면\\s?\\S{0,12}\\s?(좋아|나아|맞춰|바로잡)",
      "severity": "warn",
      "allowedExample": "이 운동과 ~ 변화는 연관 가능성이 있어요. 인과를 뜻하지 않아요"
    },
    {
      "id": "C2-03",
      "prdRow": "효과 단정",
      "regex": "효과(가|를)?\\s?(있어|봤|나타났|입증)",
      "severity": "warn",
      "allowedExample": "측정 오차보다 큰 변화가 나타났어요(자격 있는 지표만)"
    },
    {
      "id": "C2-04",
      "prdRow": "누락을 채운 서술",
      "regex": "(했|였)을\\s?거(예요|에요|야)",
      "severity": "warn",
      "allowedExample": "지난달 기록이 없어 비교할 수 없어요"
    }
  ],
