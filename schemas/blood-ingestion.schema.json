{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dfet.co.kr/schemas/blood-ingestion.schema.json",
  "title": "D-FET blood POCT result ingestion",
  "allOf": [
    { "$ref": "ingestion-envelope.schema.json" },
    {
      "properties": {
        "payload": {
          "type": "object",
          "required": ["biomarkers"],
          "properties": {
            "biomarkers": {
              "type": "array",
              "minItems": 1,
              "maxItems": 13,
              "items": {
                "type": "object",
                "required": ["code", "value", "unit"],
                "properties": {
                  "code": {
                    "enum": ["ALT", "AST", "TBIL", "DBIL", "TP", "ALB", "UREA", "CRE", "UA", "GLU", "TG", "CHOL", "HDL-C"]
                  },
                  "value": { "type": "number" },
                  "unit": { "type": "string", "minLength": 1 },
                  "flags": { "type": "array", "items": { "type": "string" } }
                },
                "additionalProperties": false
              }
            },
            "analyzer": { "type": ["object", "null"] },
            "notes": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
