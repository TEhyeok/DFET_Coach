{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dfet.co.kr/schemas/circumference-measurement.schema.json",
  "title": "circumferenceMeasurements/{measurementId} document",
  "description": "PRD §9.2 circumferenceMeasurements 표와 V1-05 §4.8을 옮긴 JSON Schema(DF-006). Firestore 네이티브 타입이 아니라 교차 클라이언트 중립 표기({\"$ts\"}·{\"$serverTimestamp\"}·{\"$int\"} 태그, contracts/fixtures/README.md 규약 2번)를 검증한다. 한 문서 = 부위 1개 × 반복 1회(trialIndex). valueCm 범위는 contracts/metric-catalog.v1.json range와 같다.",
  "type": "object",
  "required": [
    "trainerId",
    "authorUid",
    "metricCode",
    "side",
    "valueCm",
    "sourceGrade",
    "protocolId",
    "protocolVersion",
    "measuredAt",
    "trialIndex",
    "validationStatus",
    "isBeta",
    "status",
    "legalNature",
    "schemaVersion",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "memberUid": { "$ref": "#/$defs/nullableId" },
    "pendingMemberId": { "$ref": "#/$defs/nullableId" },
    "trainerId": { "description": "파생 접근 키(담당 해제 시 null).", "$ref": "#/$defs/nullableId" },
    "authorUid": { "$ref": "#/$defs/id" },
    "metricCode": {
      "description": "부록 A 둘레 코드. 형식만 검사하고 카탈로그 소속은 도메인 테스트가 본다.",
      "type": "string",
      "pattern": "^[a-z][A-Za-z0-9]*$",
      "maxLength": 64
    },
    "side": { "description": "허리·엉덩이·가슴 none, 허벅지·상완·종아리 left|right(AC-ASM-06.1).", "enum": ["none", "left", "right"] },
    "valueCm": { "type": "number", "minimum": 1, "maximum": 400 },
    "sourceGrade": { "description": "별도 시리즈. observedSection은 lidarBeta일 때만.", "enum": ["tape", "observedSection"] },
    "protocolId": { "$ref": "#/$defs/circumferenceProtocolId" },
    "protocolVersion": { "type": "string", "minLength": 1, "maxLength": 32 },
    "landmarkNote": {
      "description": "기준점 메모. protocolId가 custom이면 필수(F-ASM-06.2).",
      "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 500 }, { "type": "null" }]
    },
    "conditionsNote": { "oneOf": [{ "type": "string", "maxLength": 500 }, { "type": "null" }] },
    "measuredAt": { "description": "observedSection이면 bodyScans takenAt.", "$ref": "#/$defs/ts" },
    "trialIndex": {
      "description": "반복 순번(1부터, V1-05 상한 3).",
      "allOf": [
        { "$ref": "#/$defs/int" },
        { "properties": { "$int": { "minimum": 1, "maximum": 3 } } }
      ]
    },
    "scanId": { "$ref": "#/$defs/nullableId" },
    "referenceTapeCm": {
      "description": "비교 전용. 보정에 쓰지 않는다.",
      "oneOf": [{ "type": "number", "minimum": 1, "maximum": 400 }, { "type": "null" }]
    },
    "validationStatus": { "enum": ["unvalidated", "validated"] },
    "isBeta": { "type": "boolean" },
    "status": { "$ref": "#/$defs/measurementStatus" },
    "voidedAt": { "$ref": "#/$defs/ts" },
    "voidReason": { "description": "bodyCompositionRecords와 같은 상한.", "type": "string", "minLength": 1, "maxLength": 200 },
    "legalNature": { "const": "coachingRecord" },
    "schemaVersion": { "const": 1 },
    "createdAt": { "$ref": "#/$defs/ts" },
    "updatedAt": { "$ref": "#/$defs/ts" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "description": "회원 키: memberUid와 pendingMemberId 중 하나 이상이 문자열이다(PRD §9.1 공통 규약).",
      "anyOf": [
        { "required": ["memberUid"], "properties": { "memberUid": { "type": "string" } } },
        { "required": ["pendingMemberId"], "properties": { "pendingMemberId": { "type": "string" } } }
      ]
    },
    {
      "description": "custom 프로토콜은 기준점 메모가 필수다(PRD §9.2, 규칙 R-26).",
      "if": { "required": ["protocolId"], "properties": { "protocolId": { "const": "custom" } } },
      "then": { "required": ["landmarkNote"], "properties": { "landmarkNote": { "type": "string" } } }
    },
    {
      "description": "observedSection은 가입 회원·스캔 참조·베타·미검증이다(PRD §9.2, G-07 전).",
      "if": { "required": ["sourceGrade"], "properties": { "sourceGrade": { "const": "observedSection" } } },
      "then": {
        "required": ["memberUid", "scanId"],
        "properties": {
          "memberUid": { "type": "string" },
          "scanId": { "type": "string" },
          "isBeta": { "const": true },
          "validationStatus": { "const": "unvalidated" }
        }
      }
    },
    {
      "description": "tape는 베타가 아니고 validated다(V1-05 ASM-05-08).",
      "if": { "required": ["sourceGrade"], "properties": { "sourceGrade": { "const": "tape" } } },
      "then": { "properties": { "isBeta": { "const": false }, "validationStatus": { "const": "validated" } } }
    },
    {
      "description": "voided 문서는 voidedAt과 voidReason을 가진다(덮어쓰기 없는 정정).",
      "if": { "required": ["status"], "properties": { "status": { "const": "voided" } } },
      "then": { "required": ["voidedAt", "voidReason"] }
    }
  ],
  "$defs": {
    "ts": {
      "description": "픽스처 규약 2번. {\"$ts\": ISO 8601(Z 또는 오프셋)} 또는 쓰기 페이로드의 서버 시각 자리 {\"$serverTimestamp\": true}.",
      "oneOf": [
        {
          "type": "object",
          "required": ["$ts"],
          "properties": {
            "$ts": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["$serverTimestamp"],
          "properties": { "$serverTimestamp": { "const": true } },
          "additionalProperties": false
        }
      ]
    },
    "int": {
      "description": "픽스처 규약 2번. Firestore 정수여야 하는 값(painNrs, mmtGrade value, inkRevision, trialIndex).",
      "type": "object",
      "required": ["$int"],
      "properties": { "$int": { "type": "integer" } },
      "additionalProperties": false
    },
    "id": {
      "description": "Firestore 문서 ID 또는 Auth uid. 빈 문자열과 '/'는 쓸 수 없다.",
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^/]+$"
    },
    "nullableId": {
      "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }]
    },
    "circumferenceProtocolId": { "enum": ["waistMidpoint", "hipMaximum", "custom"] },
    "measurementStatus": { "enum": ["active", "voided"] }
  }
}
