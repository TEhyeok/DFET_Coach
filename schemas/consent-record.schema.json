{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dfet.co.kr/schemas/consent-record.schema.json",
  "title": "consentRecords/{recordId} document",
  "description": "PRD §9.2 consentRecords(append-only, 서버 작성)와 V1-05 §4.11을 옮긴 JSON Schema(DF-006). Firestore 네이티브 타입이 아니라 교차 클라이언트 중립 표기({\"$ts\"}·{\"$serverTimestamp\"} 태그, contracts/fixtures/README.md 규약 2번)를 검증한다. capturedAt·reconfirmOf·clientCaptureId는 V1-05 §4.11(ASM-05-11·12) 추가 필드다. 레코드는 수정하지 않는다(예외: 승격 시 subjectUid 한 번 채움).",
  "type": "object",
  "required": [
    "subjectUid",
    "pendingMemberId",
    "consentType",
    "action",
    "documentVersion",
    "channel",
    "recordedAt",
    "recordedBy",
    "schemaVersion"
  ],
  "properties": {
    "subjectUid": {
      "description": "가입 회원이면 처음부터, 대기 회원은 승격 시 서버가 한 번 채운다.",
      "$ref": "#/$defs/nullableId"
    },
    "pendingMemberId": { "$ref": "#/$defs/nullableId" },
    "consentType": { "$ref": "#/$defs/consentType" },
    "action": { "$ref": "#/$defs/consentAction" },
    "documentVersion": {
      "description": "consentDocumentVersions 문서 ID({consentType}--{version}, ASM-05-15).",
      "$ref": "#/$defs/id"
    },
    "channel": { "$ref": "#/$defs/consentChannel" },
    "recordedAt": { "description": "서버 시각.", "$ref": "#/$defs/ts" },
    "recordedBy": { "description": "호출자 uid(현장 동의는 트레이너).", "$ref": "#/$defs/id" },
    "capturedAt": {
      "description": "오프라인 현장 캡처 시각(클라이언트 값). 회원 앱 호출은 null.",
      "oneOf": [{ "$ref": "#/$defs/ts" }, { "type": "null" }]
    },
    "signaturePath": {
      "oneOf": [{ "type": "string", "pattern": "^consentSignatures/[^/]+\\.png$" }, { "type": "null" }]
    },
    "reconfirmedAt": {
      "description": "재확인 시 새 레코드로 기록하고 원 레코드는 불변.",
      "oneOf": [{ "$ref": "#/$defs/ts" }, { "type": "null" }]
    },
    "reconfirmOf": { "description": "재확인 대상 원 레코드 ID(ASM-05-11).", "$ref": "#/$defs/nullableId" },
    "clientCaptureId": {
      "description": "오프라인 현장 동의 재시도 멱등 키(ASM-05-12).",
      "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    },
    "schemaVersion": { "const": 1 }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "description": "대상: subjectUid와 pendingMemberId 중 하나 이상이 문자열이다.",
      "anyOf": [
        { "properties": { "subjectUid": { "type": "string" } } },
        { "properties": { "pendingMemberId": { "type": "string" } } }
      ]
    }
  ],
  "$defs": {
    "ts": {
      "description": "픽스처 규약 2번. {\"$ts\": ISO 8601(Z 또는 오프셋)} 또는 쓰기 페이로드의 서버 시각 자리 {\"$serverTimestamp\": true}.",
      "oneOf": [
        {
          "type": "object",
          "required": ["$ts"],
          "properties": {
            "$ts": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["$serverTimestamp"],
          "properties": { "$serverTimestamp": { "const": true } },
          "additionalProperties": false
        }
      ]
    },
    "id": {
      "description": "Firestore 문서 ID 또는 Auth uid. 빈 문자열과 '/'는 쓸 수 없다.",
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^/]+$"
    },
    "nullableId": {
      "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }]
    },
    "consentType": { "enum": ["required", "healthData", "bodyImaging", "sharing", "research"] },
    "consentAction": { "enum": ["grant", "withdraw"] },
    "consentChannel": { "enum": ["memberApp", "trainerDeviceInPerson"] }
  }
}
