{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TEhyeok/DFET_Coach/schemas/contracts-meta.schema.json",
  "title": "D-FET contracts input meta-schema",
  "description": "Hand-written structural schema for contracts/*.v1.json (DF-004). Normative format: docs/v1/05_DATA_MODEL_AND_RULES.md §13. Value membership (family, unit, sourceGrade, ...) and metricCode uniqueness are cross-checked against vocab by tool/contracts/generate.mjs, not duplicated here. Not a generated file and not a --check drift target.",
  "type": "object",
  "required": ["contract"],
  "properties": {
    "contract": {
      "enum": ["metric-catalog", "vocab", "prohibited-terms", "feature-flags"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "contract": { "const": "metric-catalog" } },
        "required": ["contract"]
      },
      "then": { "$ref": "#/$defs/metricCatalog" }
    },
    {
      "if": {
        "properties": { "contract": { "const": "vocab" } },
        "required": ["contract"]
      },
      "then": { "$ref": "#/$defs/vocab" }
    },
    {
      "if": {
        "properties": { "contract": { "const": "prohibited-terms" } },
        "required": ["contract"]
      },
      "then": { "$ref": "#/$defs/prohibitedTerms" }
    },
    {
      "if": {
        "properties": { "contract": { "const": "feature-flags" } },
        "required": ["contract"]
      },
      "then": { "$ref": "#/$defs/featureFlags" }
    }
  ],
  "$defs": {
    "identifier": {
      "description": "ASCII camelCase code (V1-05 §13 공통 규칙: 키와 코드 값은 영문 camelCase).",
      "type": "string",
      "pattern": "^[a-z][A-Za-z0-9]*$"
    },
    "conditionKey": {
      "description": "Field path in dot notation, or one of the derived tokens stationProfile / nrsScale (V1-05 §13.1 조건 키 토큰).",
      "type": "string",
      "pattern": "^[a-z][A-Za-z0-9]*(\\.[a-z][A-Za-z0-9]*)*$"
    },
    "conditionKeyToken": {
      "description": "metrics[].conditionKeys token: the V1-05 §13.1 조건 키 토큰 table. algorithmVersion is in that table but is not a catalog key (ASM-05-42), so it is left out.",
      "enum": [
        "protocolVersion",
        "protocolId",
        "view",
        "captureConditions.clothing",
        "stationProfile",
        "device.model",
        "deviceModel",
        "fasting",
        "timeOfDayBand",
        "sourceGrade",
        "side",
        "joint",
        "motion",
        "activeOrPassive",
        "muscleGroup",
        "nrsScale"
      ]
    },
    "storyId": {
      "type": "string",
      "pattern": "^DF-[0-9]{3}$"
    },
    "identifierList": {
      "type": "array",
      "items": { "$ref": "#/$defs/identifier" },
      "uniqueItems": true
    },
    "header": {
      "type": "object",
      "required": ["contract", "version", "revision", "source"],
      "properties": {
        "version": { "type": "integer", "const": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "source": { "type": "string", "minLength": 1, "pattern": "^[\\x20-\\x7E]+$" }
      }
    },
    "metricCatalog": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/header" }],
      "required": ["contract", "version", "revision", "source", "metrics", "excludedMetricCodes"],
      "additionalProperties": false,
      "properties": {
        "contract": { "const": "metric-catalog" },
        "version": true,
        "revision": true,
        "source": true,
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/metric" }
        },
        "excludedMetricCodes": { "$ref": "#/$defs/identifierList" }
      }
    },
    "metric": {
      "type": "object",
      "required": [
        "metricCode",
        "nameKo",
        "family",
        "unit",
        "decimals",
        "scale",
        "sideRule",
        "allowedSourceGrades",
        "screeningOnlySourceGrades",
        "betaSourceGrades",
        "reliabilityTier",
        "improvementDirection",
        "conditionKeys",
        "availability",
        "judgeAs",
        "storage",
        "range"
      ],
      "additionalProperties": false,
      "properties": {
        "metricCode": { "$ref": "#/$defs/identifier" },
        "nameKo": { "type": "string", "minLength": 1 },
        "family": { "$ref": "#/$defs/identifier" },
        "unit": { "$ref": "#/$defs/identifier" },
        "decimals": { "type": "integer", "minimum": 0, "maximum": 6 },
        "scale": { "$ref": "#/$defs/identifier" },
        "sideRule": { "$ref": "#/$defs/identifier" },
        "allowedSourceGrades": {
          "type": "array",
          "allOf": [{ "$ref": "#/$defs/identifierList" }],
          "minItems": 1
        },
        "screeningOnlySourceGrades": { "$ref": "#/$defs/identifierList" },
        "betaSourceGrades": { "$ref": "#/$defs/identifierList" },
        "reliabilityTier": {
          "oneOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }]
        },
        "improvementDirection": { "$ref": "#/$defs/identifier" },
        "conditionKeys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/conditionKeyToken" }
        },
        "availability": { "$ref": "#/$defs/identifier" },
        "judgeAs": {
          "oneOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }]
        },
        "storage": {
          "type": "object",
          "required": ["collection", "field"],
          "additionalProperties": false,
          "properties": {
            "collection": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
            "field": { "$ref": "#/$defs/conditionKey" }
          }
        },
        "range": {
          "oneOf": [
            {
              "type": "object",
              "required": ["min", "minExclusive", "max", "appMin"],
              "additionalProperties": false,
              "properties": {
                "min": { "type": "number" },
                "minExclusive": { "type": "boolean" },
                "max": { "type": "number" },
                "appMin": { "type": "number" }
              }
            },
            { "type": "null" }
          ]
        }
      }
    },
    "vocab": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/header" }],
      "required": ["contract", "version", "revision", "source", "enums", "jointMotionPairs"],
      "additionalProperties": false,
      "properties": {
        "contract": { "const": "vocab" },
        "version": true,
        "revision": true,
        "source": true,
        "enums": {
          "type": "object",
          "description": "V1-05 §13.2 enum table (33 enums). A new enum is a compatible addition (revision + 1) and must also be listed here.",
          "required": [
            "sourceGrade",
            "reliabilityTier",
            "changeStatus",
            "reasonCode",
            "mdcSource",
            "improvementDirection",
            "side",
            "syncState",
            "family",
            "sideRule",
            "availability",
            "scale",
            "unit",
            "consentType",
            "consentAction",
            "consentChannel",
            "soapStatus",
            "postureStatus",
            "measurementStatus",
            "pendingMemberStatus",
            "summaryStatus",
            "postureView",
            "clothing",
            "fasting",
            "timeOfDayBand",
            "bodyCompositionSource",
            "circumferenceProtocolId",
            "landmarkCode",
            "activeOrPassive",
            "joint",
            "motion",
            "muscleGroup",
            "regionCode"
          ],
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "$comment": "properties: enums marked ● in the V1-05 §13.2 table must carry labelsKo (27 enums).",
          "properties": {
            "sourceGrade": { "$ref": "#/$defs/enum", "required": ["labelsKo"] },
            "reliabilityTier": { "$ref": "#/$defs/enum", "required": ["labelsKo"] },
            "changeStatus": { "$ref": "#/$defs/enum", "required": ["labelsKo"] },
            "reasonCode": { "$ref": "#/$defs/enum", "required": ["labelsKo"] },
            "mdcSource": { "$ref": "#/$defs/enum", "required": ["labelsKo"] },
            "side": { "$ref": "#/$defs/enum", "required": ["labelsKo"] },
            "syncState": { "$ref": "#/$defs/enum", "required": ["labelsKo"] },
            "unit": { "$ref": "#/$defs/enum", "required": ["labelsKo"] },
            "consentType": { "$ref": "#/$defs/enum", "required": ["labelsKo"] },
            "consentAction": { "$ref": "#/$defs/enum", "required": ["labelsKo"] },
            "consentChannel": { "$ref": "#/$defs/enum", "required": ["labelsKo"] },
            "soapStatus": { "$ref": "#/$defs/enum", "required": ["labelsKo"] },
            "postureStatus": { "$ref": "#/$defs/enum", "required": ["labelsKo"] },
            "measurementStatus": { "$ref": "#/$defs/enum", "required": ["labelsKo"] },
            "pendingMemberStatus": { "$ref": "#/$defs/enum", "required": ["labelsKo"] },
            "summaryStatus": { "$ref": "#/$defs/enum", "required": ["labelsKo"] },
            "postureView": { "$ref": "#/$defs/enum", "required": ["labelsKo"] },
            "clothing": { "$ref": "#/$defs/enum", "required": ["labelsKo"] },
            "fasting": { "$ref": "#/$defs/enum", "required": ["labelsKo"] },
            "timeOfDayBand": { "$ref": "#/$defs/enum", "required": ["labelsKo"] },
            "circumferenceProtocolId": { "$ref": "#/$defs/enum", "required": ["labelsKo"] },
            "landmarkCode": { "$ref": "#/$defs/enum", "required": ["labelsKo"] },
            "activeOrPassive": { "$ref": "#/$defs/enum", "required": ["labelsKo"] },
            "joint": { "$ref": "#/$defs/enum", "required": ["labelsKo"] },
            "motion": { "$ref": "#/$defs/enum", "required": ["labelsKo"] },
            "muscleGroup": { "$ref": "#/$defs/enum", "required": ["labelsKo"] },
            "regionCode": { "$ref": "#/$defs/enum", "required": ["labelsKo"] }
          },
          "additionalProperties": { "$ref": "#/$defs/enum" }
        },
        "jointMotionPairs": { "$ref": "#/$defs/jointMotionPairs" }
      }
    },
    "draftStatus": {
      "description": "status is confirmed | draft. draft requires confirmBy; confirmed forbids it (V1-05 §13.2).",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["confirmed", "draft"] },
        "confirmBy": { "$ref": "#/$defs/storyId" }
      },
      "if": {
        "properties": { "status": { "const": "draft" } },
        "required": ["status"]
      },
      "then": { "required": ["confirmBy"] },
      "else": { "not": { "required": ["confirmBy"] } }
    },
    "enum": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/draftStatus" }],
      "required": ["status", "values"],
      "additionalProperties": false,
      "properties": {
        "status": true,
        "confirmBy": true,
        "values": {
          "type": "array",
          "allOf": [{ "$ref": "#/$defs/identifierList" }],
          "minItems": 1
        },
        "labelsKo": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "jointMotionPairs": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/draftStatus" }],
      "required": ["status", "pairs"],
      "additionalProperties": false,
      "properties": {
        "status": true,
        "confirmBy": true,
        "pairs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["joint", "motions"],
            "additionalProperties": false,
            "properties": {
              "joint": { "$ref": "#/$defs/identifier" },
              "motions": {
                "type": "array",
                "allOf": [{ "$ref": "#/$defs/identifierList" }],
                "minItems": 1
              }
            }
          }
        }
      }
    },
    "prohibitedTerms": {
      "description": "PRD appendix C as data (DF-010, ADR-016). Rule sets and path mapping: docs/v1/12_COPY_ANALYTICS_AND_LINT.md §7. Read by tool/lint/prohibited-terms.mjs; copied to Functions and rendered to Swift by the generator.",
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/header" }],
      "required": ["contract", "version", "revision", "source", "ruleSets", "causalPatterns", "abbreviationAllowlist", "pathRuleSets", "allowPaths", "excludePaths", "allowEntries"],
      "additionalProperties": false,
      "properties": {
        "contract": { "const": "prohibited-terms" },
        "version": true,
        "revision": true,
        "source": true,
        "ruleSets": {
          "type": "object",
          "required": ["common", "member", "trainer"],
          "additionalProperties": false,
          "properties": {
            "common": {
              "description": "Appendix C.1, every row. Each row carries its clinical-mode (v2) note.",
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/termRule", "required": ["clinicalModeNote"] }
            },
            "member": { "type": "array", "items": { "$ref": "#/$defs/termRule" } },
            "trainer": { "type": "array", "items": { "$ref": "#/$defs/termRule" } }
          }
        },
        "causalPatterns": {
          "description": "Appendix C.2. Always reported as warnings (ASM-P0-07).",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "prdRow", "regex", "severity", "allowedExample"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^C2-[0-9]{2}$" },
              "prdRow": { "type": "string", "minLength": 1 },
              "regex": { "type": "string", "minLength": 1 },
              "severity": { "const": "warn" },
              "allowedExample": { "type": "string", "minLength": 1 }
            }
          }
        },
        "abbreviationAllowlist": {
          "type": "object",
          "required": ["trainer"],
          "additionalProperties": false,
          "properties": {
            "trainer": {
              "type": "array",
              "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]*$" },
              "uniqueItems": true
            }
          }
        },
        "pathRuleSets": {
          "description": "First matching glob wins (ASM-P0-08).",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["glob", "ruleSets"],
            "additionalProperties": false,
            "properties": {
              "glob": { "$ref": "#/$defs/glob" },
              "ruleSets": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "enum": ["common", "member", "trainer"] }
              }
            }
          }
        },
        "allowPaths": {
          "description": "Appendix C.3 exceptions: appendix and legal quotes, test fixtures, the rule file itself.",
          "type": "array",
          "items": { "$ref": "#/$defs/glob" },
          "uniqueItems": true
        },
        "excludePaths": {
          "description": "Not product source: generated copies (the contracts input is checked instead), frozen port source, build output, third-party code.",
          "type": "array",
          "items": { "$ref": "#/$defs/glob" },
          "uniqueItems": true
        },
        "allowEntries": {
          "description": "Exact-string exceptions. Only the PRD §3.1 disclaimers may be active without an owner-reviewed regulatory PR (docs/v1/12 §7.13).",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "kind", "active", "exactString", "rules", "reason", "reviewedBy", "reviewStatus"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^AE-[0-9]{2}$" },
              "kind": { "enum": ["regulatoryDisclaimer"] },
              "active": { "type": "boolean" },
              "exactString": { "type": "string", "minLength": 1 },
              "rules": { "$ref": "#/$defs/ruleIdList" },
              "reason": { "type": "string", "minLength": 1 },
              "reviewedBy": { "type": "string", "minLength": 1 },
              "reviewStatus": { "enum": ["approvedByPrd", "approvedByOwner"] }
            }
          }
        }
      }
    },
    "termRule": {
      "type": "object",
      "required": ["id", "prdRow", "terms", "alternatives", "scopes", "severity"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^C[13]-[0-9A-Za-z-]+$" },
        "prdRow": { "type": "string", "minLength": 1 },
        "terms": {
          "description": "Plain terms. A space inside a term also matches no space or a · - _ / separator (docs/v1/12 §7.3).",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "regex": {
          "description": "Extra JavaScript-compatible patterns (flags gu), e.g. accuracy percentages.",
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "alternatives": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["ui", "summary", "notification", "marketing", "event", "input", "export"] }
        },
        "severity": { "enum": ["block", "warn"] },
        "match": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "boundary": { "const": "wordStart" },
            "except": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          }
        },
        "onlyIn": {
          "description": "The rule applies only to strings under these catalog key prefixes or these path globs.",
          "type": "object",
          "required": ["keyPrefixes", "globs"],
          "additionalProperties": false,
          "properties": {
            "keyPrefixes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "globs": { "type": "array", "items": { "$ref": "#/$defs/glob" } }
          }
        },
        "clinicalModeNote": {
          "description": "Appendix C.1 'clinical mode (v2)' column. Not read by v1 checks.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ruleIdList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^C[13]-[0-9A-Za-z-]+$" }
    },
    "glob": {
      "description": "Repository-relative path glob: ** any depth, * within one segment.",
      "type": "string",
      "pattern": "^[^/!\\\\][^\\\\]*$"
    },
    "featureFlags": {
      "description": "appConfig/features keys (DF-027, ADR-010, V1-05 §4.17 and §13.3). Every default is false: a missing document or key reads as off (AC-IA-02). Key uniqueness and generated identifier collisions are cross-checked by tool/contracts/generate.mjs.",
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/header" }],
      "required": ["contract", "version", "revision", "source", "flags"],
      "additionalProperties": false,
      "properties": {
        "contract": { "const": "feature-flags" },
        "version": true,
        "revision": true,
        "source": true,
        "flags": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/featureFlag" }
        }
      }
    },
    "featureFlag": {
      "type": "object",
      "required": ["key", "default", "phase", "descriptionKo", "ruleGatedCollections"],
      "additionalProperties": false,
      "properties": {
        "key": { "$ref": "#/$defs/identifier" },
        "default": { "description": "Always false (PRD §12.3: new flags ship off; DoD D8).", "const": false },
        "phase": { "description": "existing = member-app flag before v1 (D4). Otherwise the PRD §12 phase that may open it.", "enum": ["existing", "P1a", "P1b", "P2", "P3"] },
        "descriptionKo": { "description": "Admin-screen label (AD-07). tool/contracts/test/feature-flags.test.mjs scans it with the copy-lint common and trainer rule sets.", "type": "string", "minLength": 1 },
        "ruleGatedCollections": {
          "description": "Collections whose Firestore rules check featureOn(key) (V1-05 §13.3). A parenthesised suffix names the sourceGrade subset.",
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][A-Za-z_]*(\\([a-z][A-Za-z]*\\))?$" }
        }
      }
    }
  }
}
