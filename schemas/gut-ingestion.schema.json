{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dfet.co.kr/schemas/gut-ingestion.schema.json",
  "title": "D-FET 16S result ingestion",
  "allOf": [
    { "$ref": "ingestion-envelope.schema.json" },
    {
      "properties": {
        "payload": {
          "type": "object",
          "required": ["alpha", "beta", "abundance", "unifrac", "metadata"],
          "properties": {
            "alpha": {
              "type": "object",
              "required": ["shannon", "simpson", "chao1", "observedOtus"],
              "properties": {
                "shannon": { "type": "number" },
                "simpson": { "type": "number" },
                "chao1": { "type": "number" },
                "observedOtus": { "type": "number" }
              },
              "additionalProperties": false
            },
            "beta": {
              "type": "object",
              "required": ["pcoa"],
              "properties": {
                "pcoa": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["pc1", "pc2"],
                    "properties": {
                      "pc1": { "type": "number" },
                      "pc2": { "type": "number" },
                      "label": { "type": "string" },
                      "group": { "type": "string" },
                      "isSubject": { "type": "boolean" }
                    },
                    "additionalProperties": false
                  }
                },
                "explainedVariance": { "type": "array", "items": { "type": "number" } }
              },
              "additionalProperties": false
            },
            "abundance": {
              "type": "object",
              "required": ["phylum", "genus"],
              "properties": {
                "phylum": { "$ref": "#/$defs/composition" },
                "genus": { "$ref": "#/$defs/composition" }
              },
              "additionalProperties": false
            },
            "unifrac": {
              "type": "object",
              "required": ["weighted", "unweighted"],
              "properties": {
                "weighted": { "type": "number" },
                "unweighted": { "type": "number" }
              },
              "additionalProperties": false
            },
            "metadata": { "type": "object" }
          },
          "additionalProperties": false
        }
      }
    }
  ],
  "$defs": {
    "composition": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "value"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "value": { "type": "number", "minimum": 0 }
        },
        "additionalProperties": false
      }
    }
  }
}
