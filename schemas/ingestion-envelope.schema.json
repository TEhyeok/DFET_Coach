{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dfet.co.kr/schemas/ingestion-envelope.schema.json",
  "title": "D-FET clinical ingestion envelope",
  "type": "object",
  "required": [
    "schemaVersion", "source", "externalReportId", "revision", "memberRef",
    "sampledAt", "reportedAt", "payload", "idempotencyKey"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "source": { "type": "string", "minLength": 1 },
    "externalReportId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "revision": { "type": "integer", "minimum": 1 },
    "memberRef": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 256 },
        {
          "type": "object",
          "required": ["type", "value"],
          "properties": {
            "type": { "enum": ["uid", "externalId"] },
            "value": { "type": "string", "minLength": 1, "maxLength": 256 }
          },
          "additionalProperties": false
        }
      ]
    },
    "sampledAt": { "type": "string", "format": "date-time" },
    "reportedAt": { "type": "string", "format": "date-time" },
    "payload": { "type": "object" },
    "kit": {
      "type": "object",
      "properties": {
        "udi": { "type": "string", "minLength": 1, "maxLength": 256 },
        "lot": { "type": "string", "minLength": 1, "maxLength": 128 },
        "expiresAt": { "type": "string", "format": "date" }
      },
      "anyOf": [{ "required": ["udi"] }, { "required": ["lot"] }],
      "additionalProperties": true
    },
    "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 256 }
  },
  "additionalProperties": false
}
