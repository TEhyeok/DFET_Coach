{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dfet.co.kr/schemas/soap-addendum.schema.json",
  "title": "soap_notes/{noteId}/addenda/{addendumId} document",
  "description": "PRD §9.3 addenda 표와 V1-05 §5.3을 옮긴 JSON Schema(DF-006). Firestore 네이티브 타입이 아니라 교차 클라이언트 중립 표기({\"$ts\"}·{\"$serverTimestamp\"} 태그, contracts/fixtures/README.md 규약 2번)를 검증한다. 부모가 finalized일 때만 생성하고 수정·삭제하지 않는다는 조건은 규칙(DF-020)이 맡는다.",
  "type": "object",
  "required": ["authorUid", "createdAt", "reason", "text"],
  "properties": {
    "authorUid": { "description": "== request.auth.uid(규칙).", "$ref": "#/$defs/id" },
    "createdAt": { "description": "== request.time(규칙).", "$ref": "#/$defs/ts" },
    "reason": {
      "description": "수정 사유(정보주체 정정 요구 포함, F-PRIV-07.3).",
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "text": { "description": "추가·정정 내용.", "type": "string", "maxLength": 4000 },
    "changedFields": {
      "description": "정정 대상 필드 경로(예 plan.nextSession).",
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "pattern": "^[a-z][A-Za-z0-9]*(\\.[a-z][A-Za-z0-9]*)*$"
      }
    },
    "previousValues": {
      "description": "정정 전 값 사본. 키는 changedFields와 같은 경로.",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ts": {
      "description": "픽스처 규약 2번. {\"$ts\": ISO 8601(Z 또는 오프셋)} 또는 쓰기 페이로드의 서버 시각 자리 {\"$serverTimestamp\": true}.",
      "oneOf": [
        {
          "type": "object",
          "required": ["$ts"],
          "properties": {
            "$ts": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["$serverTimestamp"],
          "properties": { "$serverTimestamp": { "const": true } },
          "additionalProperties": false
        }
      ]
    },
    "id": {
      "description": "Firestore 문서 ID 또는 Auth uid. 빈 문자열과 '/'는 쓸 수 없다.",
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^/]+$"
    }
  }
}
